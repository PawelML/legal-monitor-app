# Copy this file to .env only when you need to override local defaults.
LEGAL_MONITOR_DATABASE_URL=postgresql+asyncpg://legal_monitor:legal_monitor@db:5432/legal_monitor
LEGAL_MONITOR_ELI_BASE_URL=https://api.sejm.gov.pl/eli

# OpenAI API
OPENAI_API_KEY=
LEGAL_MONITOR_OPENAI_MODEL=gpt-5.6-luna
LEGAL_MONITOR_OPENAI_REASONING_EFFORT=low
# Keep the approved pilot instructions only in .env; never commit them.
OPENAI_ANALYSIS_INSTRUCTIONS=
# Required by schema v2: tell the model how to select source chunk IDs.
OPENAI_ANALYSIS_EVIDENCE_PROTOCOL=
